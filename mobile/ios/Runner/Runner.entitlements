<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Notificaciones. En «development» a propósito: es lo que vale para depurar y para
		TestFlight desde Xcode; al archivar para el App Store, la firma automática lo cambia
		a «production» sola. Sin esta capacidad, el perfil sale sin `aps-environment` y el
		aparato nunca se registra en APNs, aunque Firebase esté bien configurado.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
		El contenedor que comparte la app con la extensión de compartir: por ahí entra el
		informe del escáner cuando alguien lo manda con «Compartir → GarajApp». Tiene que
		estar dado de alta en el portal de Apple y en los dos perfiles.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.garaj.garajApp</string>
	</array>
</dict>
</plist>
