# iOS 15 es el mínimo que exige firebase_core 4.x. Cubre del iPhone 6s en adelante, así que
# en la práctica no deja fuera a nadie que vaya a instalar esto.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # La extensión que pone GarajApp en «Compartir con…». Hereda las rutas de búsqueda del
  # Runner para poder importar `receive_sharing_intent`, que es todo lo que usa.
  target 'Share Extension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Algunos pods traen de fábrica un mínimo de iOS 9, 12 o 13, y Xcode 26 ya no compila
    # nada por debajo de 15. Se les impone el mismo mínimo que la app, que es el que de
    # verdad manda: lo que no corra en iOS 15 no nos sirve igual.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # La extensión de compartir importa el módulo de `receive_sharing_intent`, y ese módulo
  # incluye `Flutter/Flutter.h`. Flutter.framework aparece en la carpeta de productos recién
  # cuando el Runner corre su script, y la extensión se compila antes que él: en una
  # compilación limpia —la del archivado para la tienda— no lo encuentra y el archivado falla.
  # Compilando encima de lo anterior sí funcionaba, que es lo que lo hacía parecer bueno.
  #
  # Se le dan las mismas rutas del motor que `flutter_additional_ios_build_settings` les pone
  # a los pods. Se escriben en el xcconfig que genera CocoaPods y no en el proyecto, porque
  # llevan la ruta de Flutter de cada máquina y el proyecto sí se versiona.
  engine = File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine')
  motor = { :debug => File.join(engine, 'ios', 'Flutter.xcframework'),
            :release => File.join(engine, 'ios-release', 'Flutter.xcframework') }

  installer.aggregate_targets.each do |aggregate|
    next unless aggregate.name == 'Pods-Share Extension'

    aggregate.user_build_configurations.each do |nombre, tipo|
      carpeta = motor[tipo == :debug ? :debug : :release]
      lineas = []

      Dir.new(carpeta).each_child do |slice|
        next if slice.start_with?('.')

        if slice.end_with?('-simulator')
          lineas << "FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) \"#{carpeta}/#{slice}\""
        elsif slice.start_with?('ios-')
          lineas << "FRAMEWORK_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) \"#{carpeta}/#{slice}\""
        end
      end

      File.open(aggregate.xcconfig_path(nombre), 'a') { |f| f.puts('', lineas) }
    end
  end
end
