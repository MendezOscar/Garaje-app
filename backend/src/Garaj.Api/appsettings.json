{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "garaj-api",
    "Audience": "garaj-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "Provider": "S3",
    "ServiceUrl": "",
    "Region": "auto",
    "Bucket": "garaj-media",
    "AccessKey": "",
    "SecretKey": "",
    "ForcePathStyle": true,
    "PresignedUrlMinutes": 15
  },
  "_Assistant": "La llave va por variable de entorno (Assistant__ApiKey), nunca aquí: el repositorio es público. Vacía apaga el asistente en todos los talleres.",
  "Assistant": {
    "ApiKey": "",
    "Model": "claude-opus-5-5",
    "InputUsdPerMTok": 4.0,
    "OutputUsdPerMTok": 20.0,
    "CacheReadUsdPerMTok": 0.2,
    "CacheWriteUsdPerMTok": 5.0,
    "HnlPerUsd": 26,
    "MonthlyCapUsd": 400,
    "TimeoutSeconds": 90
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PublicBaseUrl": "",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
