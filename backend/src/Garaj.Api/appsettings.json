    "ForcePathStyle": true,
    "PresignedUrlMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "PublicBaseUrl": "",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
