{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "garaj-api",
    "Audience": "garaj-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Storage": {
    "Provider": "S3",
    "ServiceUrl": "",
    "Region": "auto",
    "Bucket": "garaj-media",
    "AccessKey": "",
